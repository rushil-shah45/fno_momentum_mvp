# Copy this file to .env and fill in your own values. Never share .env.
DHAN_CLIENT_ID=replace_with_your_client_id

# --- Option A (recommended): automatic tokens, no daily copy-paste ----------
# Needs TOTP enabled on Dhan: Dhan Web > DhanHQ Trading APIs > Setup TOTP.
# Copy the text secret key shown next to the QR code (not the 6-digit code).
DHAN_PIN=
DHAN_TOTP_SECRET=

# --- Option B: manual token (expires every 24 hours) -------------------------
# Used only if DHAN_PIN / DHAN_TOTP_SECRET above are empty.
DHAN_ACCESS_TOKEN=

# Risk controls (rupees)
MAX_RISK_PER_TRADE=250
MAX_DAILY_LOSS=500

# Paper positions are force-exited at this IST time (HH:MM)
FORCE_EXIT=15:00

# Number of top gainers (Calls) and top losers (Puts) to trade
TOP_N=5

# true  = skip trades where even 1 lot risks more than MAX_RISK_PER_TRADE
# false = always trade 1 lot (like the original project)
ENFORCE_RISK_LIMIT=true
