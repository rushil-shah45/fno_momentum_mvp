# Broker switch: 'indmoney' or 'icici' (defaults to 'indmoney' if omitted)
ACTIVE_BROKER=indmoney

# ==============================================================================
# INDMoney (INDstocks) Configuration
# ==============================================================================
# 1. Your INDstocks static Client ID (x-api-key)
#    Get this after completing TOTP setup on https://www.indstocks.com/app/api-trading/access-tokens
INDMONEY_CLIENT_ID=replace_with_your_client_id

# --- Option A (recommended): automatic 24h tokens, no manual copy-paste ------
# INDstocks trading account MPIN (e.g. 4 or 6-digit MPIN)
INDMONEY_MPIN=
# TOTP secret key (base32 string from your authenticator app setup)
INDMONEY_TOTP_SECRET=

# --- Option B: manual access token (expires every 24 hours) -------------------
# Generated from https://www.indstocks.com/app/api-trading/access-tokens
# Used only if INDMONEY_MPIN / INDMONEY_TOTP_SECRET above are empty.
INDMONEY_ACCESS_TOKEN=

# ==============================================================================
# ICICI Direct Configuration (Active when ACTIVE_BROKER=icici)
# ==============================================================================
# Breeze API App Key and Secret Key from https://api.icicidirect.com
ICICI_API_KEY=
ICICI_API_SECRET=

# --- Option A (recommended): automated login with Playwright + TOTP ---------
# Enter your ICICI Direct login User ID, Password, and TOTP secret (base32 seed)
ICICI_USER_ID=
ICICI_PASSWORD=
ICICI_TOTP_SECRET=

# --- Option B: manual session token (expires daily at midnight) --------------
# Paste the 'apisession' token extracted from the login redirect URL
ICICI_SESSION_TOKEN=

# Risk controls (rupees)
MAX_RISK_PER_TRADE=250
MAX_DAILY_LOSS=500

# Paper positions are force-exited at this IST time (HH:MM)
FORCE_EXIT=15:00

# Number of top gainers (Calls) and top losers (Puts) to trade
TOP_N=5

# true  = skip trades where even 1 lot risks more than MAX_RISK_PER_TRADE
# false = always trade 1 lot (like the original project)
ENFORCE_RISK_LIMIT=true
